          "200": {
            "description": "OK，静态文件内容"
          }
        }
      }
    },
    "/api/v1/ai-news.json": {
      "get": {
        "summary": "最新一期 AI 创业信息流：标题 + 原文链接",
        "responses": {
          "200": {
